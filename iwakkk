* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    background-color: #f4f9f9;
    color: #333;
}

/* Navbar */
header {
    background-color: #006d77;
    padding: 15px 8%;
    position: sticky;
    top: 0;
    z-index: 100;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    color: white;
    font-size: 25px;
}

.nav-menu {
    display: flex;
    list-style: none;
    gap: 25px;
}

.nav-menu a {
    text-decoration: none;
    color: white;
    font-weight: bold;
}

.nav-menu a:hover {
    color: #ffd166;
}

/* Hero */
.hero {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 40px 20px;

    background: linear-gradient(
        rgba(0, 109, 119, 0.85),
        rgba(0, 109, 119, 0.85)
    );
}

.hero-text {
    max-width: 700px;
    color: white;
}

.hero-text h2 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero-text p {
    font-size: 20px;
    line-height: 1.6;
    margin-bottom: 30px;
}

/* Button */
.btn {
    display: inline-block;
    background-color: #ffd166;
    color: #333;
    padding: 12px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background-color: #fcbf49;
    transform: scale(1.05);
}

/* Produk */
.produk {
    padding: 70px 8%;
    text-align: center;
}

.produk h2,
.tentang h2,
.kontak h2 {
    font-size: 35px;
    color: #006d77;
    margin-bottom: 10px;
}

.subtitle {
    margin-bottom: 40px;
    color: #777;
}

.produk-container {
    display: flex;
    justify-content: center;
    gap: 25px;
    flex-wrap: wrap;
}

/* Card */
.card {
    background-color: white;
    width: 300px;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-10px);
}

.ikan {
    font-size: 80px;
    margin-bottom: 15px;
}

.card h3 {
    color: #006d77;
    margin-bottom: 10px;
}

.card p {
    color: #666;
    line-height: 1.5;
    margin-bottom: 15px;
}

.card h4 {
    color: #e76f51;
    margin-bottom: 20px;
}

/* Tentang */
.tentang {
    padding: 70px 15%;
    text-align: center;
    background-color: white;
}

.tentang p {
    max-width: 700px;
    margin: auto;
    line-height: 1.8;
    color: #666;
}

/* Kontak */
.kontak {
    padding: 70px 20px;
    text-align: center;
}

.kontak > p {
    margin: 15px 0 25px;
}

.kontak-box {
    margin: 0 auto 30px;
    max-width: 500px;
    background-color: white;
    padding: 25px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.08);
}

.kontak-box p {
    margin: 10px;
}

/* Footer */
footer {
    background-color: #006d77;
    color: white;
    text-align: center;
    padding: 20px;
}

/* Responsive */
@media (max-width: 768px) {

    .navbar {
        flex-direction: column;
        gap: 15px;
    }

    .nav-menu {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
    }

    .hero-text h2 {
        font-size: 35px;
    }

    .hero-text p {
        font-size: 17px;
    }

    .produk-container {
        flex-direction: column;
        align-items: center;
    }

    .card {
        width: 90%;
        max-width: 350px;
    }
}
